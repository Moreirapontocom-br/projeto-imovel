{
  "name": "projeto-imovel",
  "private": true,
  "version": "0.1.0",
  "description": "Protótipo demonstrativo de locação de imóveis para o Carnaval de Salvador",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -b && vite build --mode api",
    "preview": "vite preview",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/artifact-html.mjs && node scripts/fetch-tiles.mjs dist-artifact/tiles",
    "typecheck": "tsc -b && tsc -p server --noEmit"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
